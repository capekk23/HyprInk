# Maintainer: HyprInk contributors
pkgname=hyprink-git
pkgver=1.0.1.r0
pkgrel=1
pkgdesc='Persistent desktop notes and scribbles for Hyprland'
arch=('x86_64' 'aarch64')
url='https://github.com/capekk23/HyprInk'
license=('MIT')
depends=('gtkmm3' 'gtk-layer-shell' 'jsoncpp')
makedepends=('cmake' 'git' 'pkgconf')
provides=('hyprink')
conflicts=('hyprink')
source=("HyprInk::git+${url}.git")
sha256sums=('SKIP')
pkgver() {
  cd HyprInk
  local version
  version=$(sed -nE 's/.*project\(HyprInk VERSION ([0-9.]+).*/\1/p' CMakeLists.txt)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}
build() {
  cmake -S HyprInk -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF
  cmake --build build
}
package() {
  DESTDIR="${pkgdir}" cmake --install build
}
